# Cambio — copy to .env. Never commit .env.

# Celo
CELO_RPC_URL=https://forno.celo.org

# The Stitch operator (maker) wallet: its ADDRESS only. The key is pasted into
# Stitch's panel when the corridor is added, and lives there — never here.
MAKER_ADDRESS=0x...

# A Textile OperatorVault per corridor, once one is connected in Stitch
# (panel → Corridors → Experimental → Trade from a vault). Empty = the bot
# trades from MAKER_ADDRESS. Fills and balances of both are always counted.
VAULT_WARS_USDT=
VAULT_WBRL_USDT=

# The news agent's paying wallet — a SEPARATE key that holds only a few dollars
# of USA₮/USDC for buy calls. Not the maker key: one leaked key should not be
# able to drain the inventory.
NEWS_PAYER_KEY=0x...

# Spend limits for the news agent, in dollars.
NEWS_MAX_PER_CALL=0.01
NEWS_DAILY_BUDGET=1.50

# Pay buy in this token: USAT (default), USDT or USDC.
NEWS_ASSET=USAT

# Feed server
FEED_PORT=8787

# How the news agent reaches the Stitch bot's config (Stitch reads it only at
# startup). With the panel: pull copies the live file, install puts Cambio's
# patch back and restarts the bot — see deploy/RUNBOOK.md step 6.
# Empty = write stitch/stitch.toml and leave installing to you.
STITCH_PULL_CMD=
STITCH_RESTART_CMD=

# Attribution tag Loops issued to THIS project's submitter (not Remesso's).
ATTRIBUTION_CODE=

# Alerts (either or both). Telegram: create a bot with @BotFather, add it to
# the team group, and put the group's chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Paid news sources: x (default), or x,reddit (both $0.005 a call).
NEWS_SOURCES=x

# Where the Stitch bot reaches the feed. The bot runs in a container, where
# localhost is the container: use the Docker gateway (RUNBOOK step 6).
FEED_PUBLIC_URL=

# Public dashboard URL, listed in the ERC-8004 registration.
DASHBOARD_URL=
